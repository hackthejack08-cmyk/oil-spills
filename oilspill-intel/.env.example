# Copy to .env (docker compose reads it automatically) or export in your shell.
# All services below are FREE; only the ones marked "account" need registration. Nothing here generates a bill
# unless you exceed the providers' free quotas (CDSE download quota, Open-Meteo 10k req/day non-commercial).

# Sentinel-1 GRD download (free CDSE account: https://dataspace.copernicus.eu). Catalogue search works without it.
OSI_CDSE_USER=
OSI_CDSE_PASSWORD=

# Optional: Copernicus Marine currents (free account: https://marine.copernicus.eu). HYCOM is used when unset.
OSI_CMEMS_USER=
OSI_CMEMS_PASSWORD=

# Optional: live AIS recording (free key: https://aisstream.io). Real-time only – cannot backfill history.
OSI_AISSTREAM_KEY=

# Optional: directory with already-downloaded .SAFE folders / zips for offline calibration
OSI_LOCAL_SAFE_DIR=
